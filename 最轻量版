local TOOLS = {}
local function sanitize(s)
    if type(s) ~= "string" then s = tostring(s) end
    s = s:gsub("[%z\1-\8\11\12\14-\31]", "")
    if #s > 2000 then s = s:sub(1, 2000) .. "...[截断]" end
    return s
end

TOOLS.run_code = function(a)
    local fn, err = loadstring(a.code or "")
    if not fn then return "编译失败: " .. tostring(err) end
    local ok, res = pcall(fn)
    return ok and ("成功: " .. tostring(res or "ok")) or ("失败: " .. tostring(res))
end
TOOLS.read_file = function(a)
    if not readfile then return "不支持 readfile" end
    local ok, c = pcall(readfile, a.path)
    if not ok then return "失败: " .. tostring(c) end
    return sanitize(c)
end
TOOLS.write_file = function(a)
    if not writefile then return "不支持 writefile" end
    local ok, e = pcall(writefile, a.path, a.content)
    return ok and ("写入成功: " .. a.path) or ("失败: " .. tostring(e))
end
TOOLS.search_file = function(a)
    if not listfiles then return "不支持 listfiles" end
    local r = {}
    local ok, fs = pcall(listfiles, a.root or ".")
    if not ok then return "搜索失败" end
    for _, f in ipairs(fs) do
        if f:lower():find((a.keyword or ""):lower(), 1, true) then
            table.insert(r, f)
        end
        if #r >= 30 then break end
    end
    return #r > 0 and sanitize(table.concat(r, "\n")) or "未找到"
end
TOOLS.list_dir = function(a)
    if not listfiles then return "不支持 listfiles" end
    local ok, fs = pcall(listfiles, a.path or ".")
    return ok and sanitize(table.concat(fs, "\n")) or "列目录失败"
end

