local function say(text, color)
    local l = Instance.new("TextLabel", log)
    l.Size = UDim2.new(1, 0, 0, 0)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or C.text
    l.TextSize = 11
    l.Font = Enum.Font.SourceSans
    l.TextWrapped = true
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.LayoutOrder = #log:GetChildren()
    task.defer(function()
        log.CanvasPosition = Vector2.new(0, log.AbsoluteCanvasSize.Y)
    end)
end

local function parseTool(t)
    t = t:gsub("```%w*\n", ""):gsub("```", "")
    local tool = t:match("[Tt][Oo][Oo][Ll]:%s*([%w_]+)")
    local args = t:match("[Aa][Rr][Gg][Ss]:%s*(%b{})")
    if tool and args then
        local ok, a = pcall(HttpService.JSONDecode, HttpService, args)
        if ok then return tool, a end
    end
    return nil, nil
end

local function run()
    if running then return end
    KEY = keyBox.Text:gsub("%s", "")
    if KEY == "" then
        say("请先填 API Key", C.red)
        setStatus("缺少 Key", C.red)
        return
    end
    local q = box.Text
    if q == "" then return end
    box.Text = ""
    say("你: " .. q, C.accent2)
    table.insert(conv, {role = "user", content = q})
    running = true
    setStatus("思考中", C.yellow)

    task.spawn(function()
        for i = 1, 15 do
            local ok, res = pcall(function()
                return request({
                    Url = API, Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["Authorization"] = "Bearer " .. KEY,
                    },
                    Body = HttpService:JSONEncode({
                        model = MODEL,
                        messages = conv,
                        temperature = 0.3,
                    }),
                })
            end)
            if not ok or res.StatusCode ~= 200 then
                say("请求失败: " .. tostring(ok and res.Body or res), C.red)
                setStatus("失败", C.red)
                running = false
                return
            end
            local reply = HttpService:JSONDecode(res.Body).choices[1].message.content
            table.insert(conv, {role = "assistant", content = reply})
            local tool, a = parseTool(reply)
            if tool and TOOLS[tool] then
                setStatus("执行 " .. tool, C.yellow)
                local result = TOOLS[tool](a)
                say("工具 " .. tool .. ": " .. sanitize(result):sub(1, 150), C.blue)
                table.insert(conv, {role = "user", content = tool .. " 返回: " .. sanitize(result)})
            else
                local code = reply:match("START%s*\n(.-)\n%s*END")
                if code then
                    say("代码:\n" .. code, C.green)
                else
                    say("AI: " .. reply)
                end
                setStatus("ready", C.green)
                running = false
                return
            end
        end
        say("达到循环上限", C.yellow)
        setStatus("上限", C.yellow)
        running = false
    end)
end

